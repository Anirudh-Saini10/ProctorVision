# HF Spaces single-origin deploy: frontend and backend share the same
# Docker container, so VITE_API_URL is empty (all requests go to the
# same origin, e.g. https://your-space.hf.space).
# The frontend derives WebSocket URL from this automatically.
VITE_API_URL=

# Lower frame rate for HF Spaces' free-tier CPU.
# Localhost uses the default 5fps from src/lib/config.js.
VITE_STREAM_FPS=3
