# Copy to .env.production (or set in Vercel project env vars) before
# building for production.
#
# This is the public URL of your Render backend, e.g.
#   https://proctorvision-api.onrender.com
# (NO trailing slash). The frontend derives the WebSocket URL from
# this automatically (http→ws, https→wss) inside src/lib/config.js.
VITE_API_URL=https://your-backend-name.onrender.com
